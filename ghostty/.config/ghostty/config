# ── Font ─────────────────────────────────────────────────────
font-family = JetBrains Mono
font-size   = 20

# Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# ── Theme ────────────────────────────────────────────────────
theme = dark:github-dark,light:github-light

# ── Window ───────────────────────────────────────────────────
window-padding-x       = 12
window-padding-y       = 10
window-padding-balance = true
# Extend the theme background into the titlebar; keep the window opaque.
macos-titlebar-style   = transparent

# ── Cursor ───────────────────────────────────────────────────
cursor-style       = bar
cursor-style-blink = true

# ── Scrollback ───────────────────────────────────────────────
# Bytes (16 MiB), not a line count.
scrollback-limit = 16777216

# ── Shell integration ────────────────────────────────────────
command                    = zsh
shell-integration          = zsh
shell-integration-features = cursor,sudo,title

# ── macOS ────────────────────────────────────────────────────
macos-option-as-alt = true
macos-window-shadow = true

# ── Keybindings ──────────────────────────────────────────────
# Unified on ctrl+shift so they behave identically on macOS and Linux.
# (cmd aliases to Super on Linux, which collides with GNOME; ctrl+shift is
# free on both and leaves ctrl+c for SIGINT and ctrl+t for fzf.)

# Copy / paste / select
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+a=select_all

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

# Splits
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+w=close_surface

# Navigate splits
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right

# Font size
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+0=reset_font_size

# Fix shift+enter for REPLs
keybind = shift+enter=text:\x1b\r
