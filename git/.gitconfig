[user]
    name = Bartek
    email = bartlomiej.milosz@gmail.com

[core]
    # Use nano as the default editor for commit messages
    editor = nano
    # Fix line endings automatically (converts CRLF to LF on commit, crucial for Linux/Windows collaboration)
    autocrlf = input
    # Define a global gitignore file for system-wide ignored files
    excludesfile = ~/.gitignore_global

[alias]
    # Basic shortcuts
    st = status
    ci = commit
    br = branch
    co = checkout
    df = diff
    
    # "Super log" - draws a commit tree, shows branches and dates in a single line
    lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    
    # Unstage files (undo 'git add')
    unstage = reset HEAD --

[color]
    # Enable colors in terminal output (status, diff, etc.)
    ui = auto

[init]
    # Set 'main' as the default branch name (instead of old 'master')
    defaultBranch = main

[push]
    # Push only the current branch to the same name on the remote
    default = simple

[pull]
    # Suppress warnings and use the standard merge strategy when pulling
    rebase = false

[fetch]
    # Automatically delete local references to remote branches that no longer exist
    prune = true

[help]
    # Autocorrect mistyped commands (e.g., 'git statsu') after 1 second (10 deciseconds)
    autocorrect = 10
