[user]
	name = Bartłomiej Miłosz
	email = bartlomiej.milosz@gmail.com

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[pull]
	ff = only

[fetch]
	prune = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram

# Optional settings for this machine (for example core.editor).
[include]
	path = ~/.gitconfig.local
