[
  // ─── NORMAL MODE: LEADER (space) ──────────────────────────────
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "space": null,

      // files
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f r": "projects::OpenRecent",
      "space f s": "workspace::Save",

      // code / lsp
      "space c a": "editor::ToggleCodeActions",
      "space c f": "editor::Format",
      "space c r": "editor::Rename",
      "space c d": "editor::GoToDefinition",
      "space c D": "editor::GoToDeclaration",
      "space c i": "editor::GoToImplementation",
      "space c h": "editor::Hover",
      "space c n": "editor::FindAllReferences",

      // search
      "space s g": "pane::DeploySearch",
      "space s s": "outline::Toggle",
      "space s S": "project_symbols::Toggle",

      // buffers
      "space b d": "pane::CloseActiveItem",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivateLastItem",

      // git
      "space g g": "git_panel::ToggleFocus",

      // ui
      "space e": "workspace::ToggleLeftDock",
      "space t": "terminal_panel::ToggleFocus",
      "space h": "editor::ToggleInlayHints",
    },
  },

  // ─── MENUS: ctrl-j/k navigation ───────────────────────────────
  {
    "context": "",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },

  // ─── INSERT MODE: completion menu ─────────────────────────────
  {
    "context": "Editor && vim_mode == insert && showing_completions",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious",
    },
  },
  
  // ─── CODE ACTIONS: completion menu ─────────────────────────────
  {
    "context": "Editor && showing_code_actions",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious"
    }
  }
]
