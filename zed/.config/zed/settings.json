{
  // ─── PRIVACY & AI ────────────────────────────────────────────
  "preferred_line_length": 110,
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },

  // ─── APPEARANCE ──────────────────────────────────────────────
  "theme": {
    "mode": "dark",
    "light": "macOS Classic Light",
    "dark": "macOS Classic Dark",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_family": ".ZedSans",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "mouse_wheel_zoom": true,

  // ─── EDITOR BEHAVIOR ─────────────────────────────────────────
  "base_keymap": "JetBrains",
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "relative_line_numbers": "disabled",
  "soft_wrap": "preferred_line_length",
  "auto_signature_help": true,
  "autosave": {
    "after_delay": { "milliseconds": 1000 },
  },
  "gutter": {
    "runnables": false,
  },

  // ─── PANELS (all docked left, agent right) ───────────────────
  "project_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },

  // ─── FILE FINDER & SCAN ──────────────────────────────────────
  "file_finder": {
    "file_icons": true,
  },
  "file_scan_exclusions": [".ruff_cache", ".git", "__pycache__", ".DS_Store"],

  // ─── WHICH KEY ───────────────────────────────────────────────
  "which_key": {
    "enabled": true,
    "delay_ms": 500,
  },

  // ─── SESSION ─────────────────────────────────────────────────
  "session": {
    "trust_all_worktrees": true,
  },

  // ─── LANGUAGES ───────────────────────────────────────────────
  "languages": {
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["-i", "2", "-ci", "-"],
        },
      },
    },
  },
}
